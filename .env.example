# Database (PostgreSQL via docker-compose)
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/gezairi

# Payload CMS
PAYLOAD_SECRET=your-secret-key-min-32-characters-long

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# S3 Storage (optional - for media uploads)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Testing
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Docker Postgres (used by docker-compose and dokploy)
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gezairi
